{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@hooks/*": ["./src/apps/finora/hooks/*"],
      "@domain/*": ["./src/apps/finora/domain/*"],
      "@components/*": ["./src/apps/finora/components/*"],
      "@services/*": ["./src/apps/finora/services/*"],
      "@context/*": ["./src/apps/finora/context/*"],
      "@atoms/*": ["./src/apps/finora/components/atoms/*"],
      "@molecules/*": ["./src/apps/finora/components/molecules/*"],
      "@organisms/*": ["./src/apps/finora/components/organisms/*"]
    }
  },
  "include": ["src"]
}